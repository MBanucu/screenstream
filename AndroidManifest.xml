<?xml version="1.0" encoding="utf-8"?>
<!-- The library's own manifest. Gradle merges it into an app that depends on the
     AAR, so a consumer adds no declarations of its own; an app that compiles the
     sources directly, the way samples/build.sh does, copies these two elements
     into its own manifest instead. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mbanucu.screenstream">

    <!-- The stream is served on 127.0.0.1, which still needs the socket permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>

        <!-- Asks for the screen once, then hands it to the service. Started by the
             app itself, by adb, or not at all if the app asks for the projection
             on its own and calls ScreenStream.start. -->
        <activity
            android:name=".ScreenStreamActivity"
            android:exported="true"
            android:label="Screen stream" />

        <!-- Raw frames on 127.0.0.1:7100, for apps and for `adb forward`. -->
        <service
            android:name=".ScreenStream"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
